[Unit]
Description=QuestLayer exploration game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=questlayer-hackathon
StateDirectoryMode=0700
WorkingDirectory=/var/lib/questlayer-hackathon
ExecStart=/usr/local/bin/node /opt/ps3000/apps/questlayer-hackathon/current/server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=loopback
Environment=PORT=7091
Environment=APP_ORIGIN=https://questlayer.promptstudio3000.com
Environment=DATABASE_PATH=/var/lib/questlayer-hackathon/questlayer-hackathon.sqlite
Environment=STATIC_ASSET_DIR=/opt/ps3000/apps/questlayer-hackathon/assets
Environment=NEAR_NETWORK=testnet
Environment=NEAR_RPC_URL=https://test.rpc.fastnear.com
# Testnet test world (docs/TEST-SEED.md). Delete this line (or set TEST_SEED=0
# in runtime.env) and the next start removes everything it seeded.
Environment=TEST_SEED=1
# City days are funded only by realized staking yield (docs/GLOBAL-TREASURY.md):
# each day takes one seventh of the yield that is still free, so every day
# carries some yield, however small. Delete both lines to fall back to the
# sponsor-funded 0.012 NEAR per day.
Environment=NATIVE_YIELD_BACKED_DAYS=1
Environment=NATIVE_YIELD_DRIP_DAYS=7
# Plzeň demo layout (docs/DEMO-ZONES.md): six zones on the ring of parks around
# náměstí Republiky, all open the whole day (no countdown), NPCs and monsters
# near the centre. Delete this line for the final product: the next world goes
# back to citywide zones with rarity windows. Refused on mainnet.
Environment=DEMO_ZONES=plzen-compact
# Level item editions L5-L10 (docs/LEVELS.md, owner-approved 1 Nov). Testnet only;
# each stays unavailable until the deployed collectibles contract lists it.
Environment=LEVEL_ITEM_EDITIONS=1
EnvironmentFile=-/opt/ps3000/apps/questlayer-hackathon/runtime.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/questlayer-hackathon
MemoryMax=512M
CPUQuota=75%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
