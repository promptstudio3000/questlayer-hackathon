[Unit]
Description=AuraTrail exploration game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=auratrail
StateDirectoryMode=0700
WorkingDirectory=/var/lib/auratrail
ExecStart=/usr/local/bin/node /opt/ps3000/apps/auratrail/current/server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=loopback
Environment=PORT=7091
Environment=APP_ORIGIN=https://questlayer.promptstudio3000.com
Environment=DATABASE_PATH=/var/lib/auratrail/auratrail.sqlite
Environment=NEAR_NETWORK=testnet
Environment=NEAR_RPC_URL=https://rpc.testnet.near.org
EnvironmentFile=-/opt/ps3000/apps/auratrail/runtime.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/auratrail
MemoryMax=512M
CPUQuota=75%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
