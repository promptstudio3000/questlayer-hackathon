.near-credentials/

# Temporary upstream artwork used only by the local reference preview.
dev/reference-6741.glb
dev/reference-wearable-*.svg

# Private state and cloud-local configuration never belong in source control.
*.sqlite
*.sqlite-*
*.db
*.db-*
runtime.env
*.tgz
*.tar.gz
build-id.txt

# Browser sign-in state (Playwright storageState) holds live session cookies.
# A script that writes to `${undefined}/...` lands in undefined/: never commit it.
undefined/
playwright/.auth/
*storage-state*.json
*storageState*.json
*auth-state*.json

# QA screenshots and recordings are regenerated by the e2e scripts; keep them
# out of the repository (reports and proofs under output/ stay text).
output/**/*.png
output/**/*.jpg
output/**/*.jpeg
output/**/*.webp
output/**/*.gif
output/**/*.webm
output/**/*.mp4
