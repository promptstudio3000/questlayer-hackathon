+
+test("malformed, oversized and streamed oversized JSON cannot create records", async (t) => {
+  const f = fixture(t);
+  for (const body of ["{", "null", "[]", '"string"'])
+    assert.equal(
+      (await f.request("/quests", { method: "POST", body })).status,
