diff --git a/server/creators/api.mjs b/server/creators/api.mjs
new file mode 100644
index 0000000..1ab9d90
--- /dev/null
+++ b/server/creators/api.mjs
@@ -0,0 +1,282 @@
+import { GameError } from "../domain.mjs";
+import {
+  creatorAssert as fail,
+  creatorFields as fields,
+} from "./operations.mjs";
+
+const PREFIX = "/api/creator-community";
+const BODY_LIMIT = 16_384;
+const commonHeaders = {
+  "Content-Type": "application/json; charset=utf-8",
+  "Cache-Control": "private, no-store",
+  "X-Content-Type-Options": "nosniff",
+};
+const response = (status, body) =>
+  new Response(JSON.stringify(body), { status, headers: commonHeaders });
+async function jsonBody(request) {
+  fail(
+    /^application\/json(?:\s*;|$)/i.test(
+      request.headers.get("content-type") ?? "",
+    ),
+    "Send creator actions as JSON.",
+    "CREATOR_CONTENT_TYPE",
+    415,
+  );
+  const reader = request.body?.getReader();
+  fail(reader, "A creator action body is required.", "CREATOR_INPUT", 400);
+  const chunks = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > BODY_LIMIT) {
+        await reader.cancel();
+        fail(
+          false,
+          "Creator action body is too large.",
+          "CREATOR_BODY_LIMIT",
+          413,
+        );
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  let value;
+  try {
+    value = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+  } catch {
+    fail(false, "Invalid creator JSON.", "CREATOR_INPUT", 400);
+  }
+  fail(
+    value && typeof value === "object" && !Array.isArray(value),
+    "A creator action object is required.",
+    "CREATOR_INPUT",
+    400,
+  );
+  return value;
+}
+function query(url, allowed) {
+  for (const name of url.searchParams.keys()) {
+    fail(
+      allowed.includes(name) && url.searchParams.getAll(name).length === 1,
+      "Unsupported or repeated Community query.",
+      "CREATOR_INPUT",
+      400,
+    );
+  }
+  const result = {};
+  if (url.searchParams.has("limit")) {
+    const value = url.searchParams.get("limit");
+    fail(
+      /^[1-9][0-9]?$/.test(value),
+      "Invalid Community page size.",
+      "CREATOR_INPUT",
+      400,
+    );
+    result.limit = Number(value);
+  }
+  if (url.searchParams.has("cursor"))
+    result.cursor = url.searchParams.get("cursor");
+  if (url.searchParams.has("creator"))
+    result.creatorId = url.searchParams.get("creator");
+  if (url.searchParams.has("following")) {
+    const value = url.searchParams.get("following");
+    fail(
+      ["true", "false"].includes(value),
+      "Invalid Following filter.",
+      "CREATOR_INPUT",
+      400,
+    );
+    result.followingOnly = value === "true";
+  }
+  return result;
+}
+
+// Web Request/Response adapter for the existing server to mount deliberately.
+// authenticate must verify the host's real session; body fields never select actor/roles.
+// Moderation and completion authority are intentionally absent from player routes.
+export function createCreatorApi({
+  lifecycle,
+  community,
+  authenticate,
+  origin,
+  enabled = false,
+}) {
+  const siteOrigin = new URL(origin).origin;
+  fail(
+    typeof authenticate === "function",
+    "Creator routes require session authentication.",
+    "CREATOR_CONFIG",
+    500,
+  );
+  return async function handleCreatorRequest(request) {
+    const url = new URL(request.url);
+    if (!(url.pathname === PREFIX || url.pathname.startsWith(PREFIX + "/")))
+      return null;
+    if (enabled !== true)
+      return response(404, {
+        error: "Creator Community is not enabled.",
+        code: "CREATOR_DISABLED",
+      });
+    try {
+      fail(
+        url.origin === siteOrigin,
+        "Creator request origin does not match this application.",
+        "CREATOR_ORIGIN",
+        403,
+      );
+      const write = !["GET", "HEAD"].includes(request.method);
+      if (write)
+        fail(
+          request.headers.get("origin") === siteOrigin,
+          "Open this creator action from the application.",
+          "CREATOR_ORIGIN",
+          403,
+        );
+      const actor = await authenticate(request);
+      fail(
+        typeof actor === "string" && actor.length > 0,
+        "Sign in to use Community.",
+        "CREATOR_AUTH",
+        401,
+      );
+      const suffix = url.pathname.slice(PREFIX.length);
+      const parts = suffix
+        .split("/")
+        .filter(Boolean)
+        .map((part) => decodeURIComponent(part));
+      let result;
+      if (request.method === "GET") {
+        const options = query(
+          url,
+          parts.length === 1 && parts[0] === "quests"
+            ? ["limit", "cursor", "creator", "following"]
+            : (parts.length === 1 && parts[0] === "creators") ||
+                suffix === "/me/quests"
+              ? ["limit", "cursor"]
+              : [],
+        );
+        if (suffix === "/me")
+          result = {
+            domain: "demo",
+            profile: community.myProfile(actor),
+            progression: lifecycle.progression(actor),
+          };
+        else if (suffix === "/me/quests")
+          result = community.myCreations(actor, options);
+        else if (suffix === "/creators")
+          result = community.listCreators(actor, options);
+        else if (suffix === "/quests")
+          result = community.listQuests(actor, options);
+        else if (parts.length === 2 && parts[0] === "creators")
+          result = community.profile(actor, parts[1]);
+        else if (parts.length === 2 && parts[0] === "quests")
+          result = community.publicQuest(actor, parts[1]);
+        else if (
+          parts.length === 3 &&
+          parts[0] === "quests" &&
+          parts[2] === "participation"
+        )
+          result = community.myParticipation(actor, parts[1]);
+        else if (
+          parts.length === 3 &&
+          parts[0] === "quests" &&
+          parts[2] === "publication-quote"
+        )
+          result = lifecycle.publicationQuote(actor, parts[1]);
+        else
+          return response(404, {
+            error: "Creator route not found.",
+            code: "CREATOR_NOT_FOUND",
+          });
+      } else {
+        query(url, []);
+        fail(
+          ["POST", "PUT"].includes(request.method),
+          "Creator method not supported.",
+          "CREATOR_METHOD",
+          405,
+        );
+        const body = await jsonBody(request);
+        if (request.method === "PUT" && suffix === "/profile") {
+          fields(body, [
+            "operationId",
+            "expectedVersion",
+            "profile",
+            "publicConsent",
+          ]);
+          result = community.saveProfile({ actor, ...body });
+        } else if (
+          request.method === "PUT" &&
+          parts.length === 3 &&
+          parts[0] === "creators" &&
+          parts[2] === "follow"
+        ) {
+          fields(body, ["operationId", "following"]);
+          result = community.setFollowing({
+            actor,
+            creatorId: parts[1],
+            ...body,
+          });
+        } else if (request.method === "POST" && suffix === "/quests") {
+          fields(body, ["operationId", "questId", "draft"]);
+          result = lifecycle.createDraft({ actor, ...body });
+        } else if (
+          request.method === "POST" &&
+          parts.length === 3 &&
+          parts[0] === "quests"
+        ) {
+          const actions = {
+            revisions: ["revise", ["operationId", "expectedVersion", "draft"]],
+            submit: [
+              "submit",
+              ["operationId", "expectedVersion", "expectedPolicyVersion"],
+            ],
+            "withdraw-review": [
+              "withdrawReview",
+              ["operationId", "expectedVersion"],
+            ],
+            close: ["close", ["operationId", "expectedVersion"]],
+            finalize: ["finalize", ["operationId", "expectedVersion"]],
+            participation: ["start", ["operationId"]],
+          };
+          const action = Object.hasOwn(actions, parts[2])
+            ? actions[parts[2]]
+            : null;
+          if (!action)
+            return response(404, {
+              error: "Creator route not found.",
+              code: "CREATOR_NOT_FOUND",
+            });
+          fields(body, action[1]);
+          result = lifecycle[action[0]]({ actor, questId: parts[1], ...body });
+        } else
+          return response(404, {
+            error: "Creator route not found.",
+            code: "CREATOR_NOT_FOUND",
+          });
+      }
+      return response(200, result);
+    } catch (error) {
+      if (error instanceof URIError)
+        return response(400, {
+          error: "Invalid creator route.",
+          code: "CREATOR_INPUT",
+        });
+      if (error instanceof GameError)
+        return response(error.status, {
+          error: error.message,
+          code: error.code,
+        });
+      return response(500, {
+        error:
+          "Creator action could not be confirmed. Retry with the same operation ID.",
+        code: "CREATOR_UNAVAILABLE",
+      });
+    }
+  };
+}
diff --git a/server/creators/community.mjs b/server/creators/community.mjs
new file mode 100644
index 0000000..a41c91c
--- /dev/null
+++ b/server/creators/community.mjs
@@ -0,0 +1,324 @@
+import { atomic } from "../database.mjs";
+import { initSocialBlocks } from "../social-content.mjs";
+import {
+  creatorAssert as fail,
+  creatorKey as key,
+  creatorInteger as integer,
+  creatorText as text,
+  creatorFields as fields,
+  createCreatorOperations,
+} from "./operations.mjs";
+
+// Public projections always select approved fields. Never serialize lifecycle rows.
+export function createCreatorCommunity(db, { clock = Date.now } = {}) {
+  fail(
+    db
+      .prepare(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='creator_operations'",
+      )
+      .get(),
+    "Initialize the creator lifecycle before Community.",
+    "CREATOR_STORAGE",
+    500,
+  );
+  initSocialBlocks(db);
+  atomic(db, () =>
+    db.exec(`
+    CREATE TABLE IF NOT EXISTS creator_profiles(
+      player_id TEXT PRIMARY KEY REFERENCES players(id), display_name TEXT NOT NULL,
+      bio TEXT NOT NULL, public INTEGER NOT NULL CHECK(public IN(0,1)),
+      version INTEGER NOT NULL CHECK(version>0), updated_at INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS creator_follows(
+      follower TEXT NOT NULL REFERENCES players(id), creator TEXT NOT NULL REFERENCES players(id),
+      created_at INTEGER NOT NULL, PRIMARY KEY(follower,creator), CHECK(follower!=creator));
+    CREATE INDEX IF NOT EXISTS creator_follow_targets ON creator_follows(creator,follower);
+  `),
+  );
+  const operation = createCreatorOperations(db, { clock });
+  function player(id) {
+    key(id);
+    fail(
+      db.prepare("SELECT 1 FROM players WHERE id=?").get(id),
+      "Sign in to use Community.",
+      "CREATOR_AUTH",
+      401,
+    );
+  }
+  function pagination({ limit = 20, cursor = "" } = {}) {
+    integer(limit, 1);
+    fail(
+      limit <= 50,
+      "Use a Community page of at most 50 entries.",
+      "CREATOR_INPUT",
+      400,
+    );
+    if (cursor !== "") key(cursor);
+    return { limit, cursor };
+  }
+  function page(rows, limit, project) {
+    const hasMore = rows.length > limit;
+    const visible = rows.slice(0, limit);
+    return {
+      domain: "demo",
+      items: visible.map(project),
+      nextCursor: hasMore ? visible.at(-1).id : null,
+    };
+  }
+  // A bilateral block hides discovery in both directions, independent of who set it.
+  const unblocked = (column) => `NOT EXISTS(SELECT 1 FROM social_blocks b WHERE
+    (b.actor_id=:viewer AND b.target_id=${column}) OR (b.target_id=:viewer AND b.actor_id=${column}))`;
+  const profileView = (row) => ({
+    id: row.id,
+    displayName: row.display_name,
+    bio: row.bio,
+  });
+  const questView = (row) => ({
+    id: row.id,
+    revision: row.published_revision,
+    title: row.title,
+    description: row.description,
+    creator: { id: row.author, displayName: row.display_name },
+    access: "free",
+    rewardStatus: "not-configured",
+    domain: "demo",
+  });
+  const approvedColumns = `q.id,q.author,q.published_revision,p.display_name,
+    json_extract(r.content,'$.title') AS title,json_extract(r.content,'$.description') AS description`;
+  const approvedJoins = `FROM creator_quests q
+    JOIN creator_profiles p ON p.player_id=q.author AND p.public=1
+    JOIN creator_revisions r ON r.quest_id=q.id AND r.revision=q.published_revision AND r.state='approved'`;
+
+  function profile(actor, creatorId) {
+    player(actor);
+    key(creatorId);
+    const row = db
+      .prepare(
+        `SELECT p.player_id AS id,p.display_name,p.bio FROM creator_profiles p
+      WHERE p.player_id=:creator AND p.public=1 AND ${unblocked("p.player_id")}`,
+      )
+      .get({ viewer: actor, creator: creatorId });
+    fail(row, "Creator profile not found.", "CREATOR_NOT_FOUND", 404);
+    return {
+      domain: "demo",
+      ...profileView(row),
+      following: !!db
+        .prepare("SELECT 1 FROM creator_follows WHERE follower=? AND creator=?")
+        .get(actor, creatorId),
+    };
+  }
+  function listQuests(actor, options = {}) {
+    player(actor);
+    const { limit, cursor } = pagination(options);
+    const { creatorId = null, followingOnly = false } = options;
+    if (creatorId !== null) key(creatorId);
+    fail(
+      typeof followingOnly === "boolean",
+      "Choose a valid Following filter.",
+      "CREATOR_INPUT",
+      400,
+    );
+    const rows = db
+      .prepare(
+        `SELECT ${approvedColumns} ${approvedJoins}
+      WHERE q.state='published' AND q.id>:cursor AND ${unblocked("q.author")}
+      AND (:creator IS NULL OR q.author=:creator)
+      AND (:following=0 OR EXISTS(SELECT 1 FROM creator_follows f WHERE f.follower=:viewer AND f.creator=q.author))
+      ORDER BY q.id LIMIT :take`,
+      )
+      .all({
+        viewer: actor,
+        cursor,
+        creator: creatorId,
+        following: Number(followingOnly),
+        take: limit + 1,
+      });
+    return page(rows, limit, questView);
+  }
+  return {
+    profile,
+    listQuests,
+    publicQuest(actor, questId) {
+      player(actor);
+      key(questId);
+      const row = db
+        .prepare(
+          `SELECT ${approvedColumns} ${approvedJoins}
+        WHERE q.id=:quest AND q.state='published' AND ${unblocked("q.author")}`,
+        )
+        .get({ viewer: actor, quest: questId });
+      fail(row, "Creator quest not found.", "CREATOR_NOT_FOUND", 404);
+      return questView(row);
+    },
+    listCreators(actor, options = {}) {
+      player(actor);
+      const { limit, cursor } = pagination(options);
+      const rows = db
+        .prepare(
+          `SELECT p.player_id AS id,p.display_name,p.bio FROM creator_profiles p
+        WHERE p.public=1 AND p.player_id>:cursor AND ${unblocked("p.player_id")}
+        ORDER BY p.player_id LIMIT :take`,
+        )
+        .all({ viewer: actor, cursor, take: limit + 1 });
+      return page(rows, limit, profileView);
+    },
+    myCreations(actor, options = {}) {
+      player(actor);
+      const { limit, cursor } = pagination(options);
+      const rows = db
+        .prepare(
+          `SELECT q.id,q.state,q.version,q.latest_revision,q.published_revision,r.content,
+        c.amount AS commitment_xp,c.released_at,
+        (SELECT count(*) FROM creator_participations a WHERE a.quest_id=q.id AND a.state='open') AS open_participations
+        FROM creator_quests q JOIN creator_revisions r ON r.quest_id=q.id AND r.revision=q.latest_revision
+        LEFT JOIN creator_xp_commitments c ON c.quest_id=q.id
+        WHERE q.author=:viewer AND q.id>:cursor ORDER BY q.id LIMIT :take`,
+        )
+        .all({ viewer: actor, cursor, take: limit + 1 });
+      return page(rows, limit, (row) => ({
+        id: row.id,
+        state: row.state,
+        version: row.version,
+        latestRevision: row.latest_revision,
+        publishedRevision: row.published_revision,
+        draft: JSON.parse(row.content),
+        lockedXp: row.released_at === null ? (row.commitment_xp ?? 0) : 0,
+        openParticipations: row.open_participations,
+      }));
+    },
+    myProfile(actor) {
+      player(actor);
+      const row = db
+        .prepare("SELECT * FROM creator_profiles WHERE player_id=?")
+        .get(actor);
+      return row
+        ? {
+            id: actor,
+            displayName: row.display_name,
+            bio: row.bio,
+            public: !!row.public,
+            version: row.version,
+          }
+        : { id: actor, displayName: "", bio: "", public: false, version: 0 };
+    },
+    myParticipation(actor, questId) {
+      player(actor);
+      key(questId);
+      const row = db
+        .prepare(
+          `SELECT a.quest_id,a.revision,a.state,q.state AS quest_state,r.content
+        FROM creator_participations a JOIN creator_revisions r ON r.quest_id=a.quest_id AND r.revision=a.revision
+        JOIN creator_quests q ON q.id=a.quest_id WHERE a.quest_id=? AND a.participant=?`,
+        )
+        .get(questId, actor);
+      fail(
+        row,
+        "Your quest participation was not found.",
+        "CREATOR_NOT_FOUND",
+        404,
+      );
+      // Existing rights remain accessible privately even after closure, profile hiding or a block.
+      return {
+        domain: "demo",
+        questId: row.quest_id,
+        revision: row.revision,
+        state: row.state,
+        questState: row.quest_state,
+        content: JSON.parse(row.content),
+        rewardStatus: "not-configured",
+      };
+    },
+    saveProfile({
+      actor,
+      operationId,
+      expectedVersion,
+      profile: input,
+      publicConsent,
+    }) {
+      fields(input, ["displayName", "bio", "public"]);
+      const validated = {
+        displayName: text(input.displayName, 80),
+        bio: text(input.bio, 1000, { optional: true }),
+        public: input.public,
+      };
+      fail(
+        typeof validated.public === "boolean" &&
+          typeof publicConsent === "boolean",
+        "Choose profile visibility and consent.",
+        "CREATOR_INPUT",
+        400,
+      );
+      fail(
+        !validated.public || publicConsent,
+        "Confirm public profile publication first.",
+        "CREATOR_CONSENT",
+        400,
+      );
+      integer(expectedVersion);
+      return operation(
+        "saveProfile",
+        actor,
+        operationId,
+        { expectedVersion, profile: validated, publicConsent },
+        (now) => {
+          player(actor);
+          const old = db
+            .prepare("SELECT version FROM creator_profiles WHERE player_id=?")
+            .get(actor);
+          fail(
+            (old?.version ?? 0) === expectedVersion,
+            "The creator profile changed. Refresh before saving.",
+            "CREATOR_STALE",
+          );
+          db.prepare(
+            `INSERT INTO creator_profiles VALUES (?,?,?,?,?,?) ON CONFLICT(player_id)
+          DO UPDATE SET display_name=excluded.display_name,bio=excluded.bio,public=excluded.public,version=excluded.version,updated_at=excluded.updated_at`,
+          ).run(
+            actor,
+            validated.displayName,
+            validated.bio,
+            Number(validated.public),
+            integer(expectedVersion + 1, 1),
+            now,
+          );
+          return {
+            profile: { id: actor, ...validated, version: expectedVersion + 1 },
+          };
+        },
+      );
+    },
+    setFollowing({ actor, operationId, creatorId, following }) {
+      key(creatorId);
+      fail(
+        typeof following === "boolean",
+        "Choose a Following state.",
+        "CREATOR_INPUT",
+        400,
+      );
+      return operation(
+        "setFollowing",
+        actor,
+        operationId,
+        { creatorId, following },
+        (now) => {
+          player(actor);
+          fail(
+            actor !== creatorId,
+            "You cannot follow yourself.",
+            "CREATOR_INPUT",
+            400,
+          );
+          if (following) {
+            profile(actor, creatorId);
+            db.prepare(
+              "INSERT OR IGNORE INTO creator_follows VALUES (?,?,?)",
+            ).run(actor, creatorId, now);
+          } else
+            db.prepare(
+              "DELETE FROM creator_follows WHERE follower=? AND creator=?",
+            ).run(actor, creatorId);
+          return { creatorId, following };
+        },
+      );
+    },
+  };
+}
diff --git a/server/creators/lifecycle.mjs b/server/creators/lifecycle.mjs
new file mode 100644
index 0000000..2f3551e
--- /dev/null
+++ b/server/creators/lifecycle.mjs
@@ -0,0 +1,550 @@
+import { atomic } from "../database.mjs";
+import { levelFor } from "../domain.mjs";
+import {
+  creatorAssert as fail,
+  creatorKey as key,
+  creatorInteger as integer,
+  creatorText as text,
+  createCreatorOperations,
+} from "./operations.mjs";
+
+const content = (value) => {
+  fail(
+    value && Object.keys(value).sort().join() === "description,title",
+    "Only free quest title and description are supported.",
+    "CREATOR_INPUT",
+    400,
+  );
+  return {
+    title: text(value.title, 100),
+    description: text(value.description, 4000),
+  };
+};
+// Explicit opt-in demo adapter. The running application does not import this module.
+// Identities and authority predicates must come from trusted server adapters.
+export function createCreatorLifecycle(
+  db,
+  {
+    policy,
+    isModerator = () => false,
+    isCompletionAuthority = () => false,
+    authorizeAdmission = () => true,
+    clock = Date.now,
+  } = {},
+) {
+  fail(
+    policy && Object.keys(policy).sort().join() === "version,xpCommitment",
+    "An explicit versioned XP policy is required.",
+    "CREATOR_POLICY",
+    400,
+  );
+  const configuredPolicy = {
+    version: key(policy.version),
+    xpCommitment: integer(policy.xpCommitment, 1),
+  };
+  fail(
+    db.prepare("PRAGMA foreign_keys").get().foreign_keys === 1,
+    "Creator storage requires foreign keys.",
+    "CREATOR_STORAGE",
+    500,
+  );
+  atomic(db, () => {
+    db.exec(`
+      CREATE TABLE IF NOT EXISTS creator_policies(
+        version TEXT PRIMARY KEY, xp_commitment INTEGER NOT NULL CHECK(xp_commitment>0));
+      CREATE TABLE IF NOT EXISTS creator_quests(
+        id TEXT PRIMARY KEY, author TEXT NOT NULL REFERENCES players(id),
+        state TEXT NOT NULL CHECK(state IN ('draft','pending_review','rejected','published','closing','closed')),
+        version INTEGER NOT NULL, latest_revision INTEGER NOT NULL,
+        published_revision INTEGER, policy_version TEXT REFERENCES creator_policies(version),
+        created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS creator_revisions(
+        quest_id TEXT NOT NULL REFERENCES creator_quests(id), revision INTEGER NOT NULL,
+        content TEXT NOT NULL, state TEXT NOT NULL CHECK(state IN ('draft','pending_review','approved','rejected','withdrawn')),
+        policy_version TEXT REFERENCES creator_policies(version), reviewed_by TEXT, reason TEXT,
+        PRIMARY KEY(quest_id,revision));
+      CREATE TABLE IF NOT EXISTS creator_xp_commitments(
+        quest_id TEXT PRIMARY KEY REFERENCES creator_quests(id),
+        author TEXT NOT NULL REFERENCES players(id), amount INTEGER NOT NULL CHECK(amount>0),
+        policy_version TEXT NOT NULL REFERENCES creator_policies(version),
+        locked_at INTEGER NOT NULL, released_at INTEGER);
+      CREATE INDEX IF NOT EXISTS creator_active_xp ON creator_xp_commitments(author) WHERE released_at IS NULL;
+      CREATE TABLE IF NOT EXISTS creator_participations(
+        quest_id TEXT NOT NULL, participant TEXT NOT NULL REFERENCES players(id), revision INTEGER NOT NULL,
+        state TEXT NOT NULL CHECK(state IN ('open','resolved')), started_at INTEGER NOT NULL,
+        resolved_at INTEGER, resolved_by TEXT, resolution_reference TEXT,
+        PRIMARY KEY(quest_id,participant),
+        FOREIGN KEY(quest_id,revision) REFERENCES creator_revisions(quest_id,revision));
+      CREATE TABLE IF NOT EXISTS creator_operations(
+        actor TEXT NOT NULL, operation_id TEXT NOT NULL, command TEXT NOT NULL,
+        fingerprint TEXT NOT NULL, receipt TEXT NOT NULL, created_at INTEGER NOT NULL,
+        PRIMARY KEY(actor,operation_id));
+    `);
+    const existing = db
+      .prepare("SELECT xp_commitment FROM creator_policies WHERE version=?")
+      .get(configuredPolicy.version);
+    fail(
+      !existing || existing.xp_commitment === configuredPolicy.xpCommitment,
+      "An existing XP policy version cannot change.",
+      "CREATOR_POLICY",
+    );
+    if (!existing)
+      db.prepare("INSERT INTO creator_policies VALUES (?,?)").run(
+        configuredPolicy.version,
+        configuredPolicy.xpCommitment,
+      );
+  });
+
+  function player(id) {
+    const row = db.prepare("SELECT xp FROM players WHERE id=?").get(key(id));
+    fail(row, "Creator player not found.", "CREATOR_NOT_FOUND", 404);
+    integer(row.xp);
+    return row;
+  }
+  function progression(author) {
+    const earnedXp = player(author).xp;
+    const lockedXp = db
+      .prepare(
+        `SELECT COALESCE(SUM(amount),0) AS xp
+      FROM creator_xp_commitments WHERE author=? AND released_at IS NULL`,
+      )
+      .get(author).xp;
+    integer(lockedXp);
+    fail(
+      lockedXp <= earnedXp,
+      "Creator XP accounting needs reconciliation.",
+      "CREATOR_XP_INVARIANT",
+      503,
+    );
+    const availableXp = earnedXp - lockedXp;
+    return {
+      domain: "demo",
+      earnedXp,
+      lockedXp,
+      availableXp,
+      level: levelFor(availableXp),
+    };
+  }
+  function quest(id) {
+    const row = db
+      .prepare("SELECT * FROM creator_quests WHERE id=?")
+      .get(key(id));
+    fail(row, "Creator quest not found.", "CREATOR_NOT_FOUND", 404);
+    return row;
+  }
+  function revision(id, number) {
+    const row = db
+      .prepare(
+        "SELECT * FROM creator_revisions WHERE quest_id=? AND revision=?",
+      )
+      .get(id, number);
+    fail(row, "Creator revision not found.", "CREATOR_NOT_FOUND", 404);
+    return { ...row, content: JSON.parse(row.content) };
+  }
+  function participation(id, participant) {
+    return (
+      db
+        .prepare(
+          "SELECT * FROM creator_participations WHERE quest_id=? AND participant=?",
+        )
+        .get(key(id), key(participant)) ?? null
+    );
+  }
+  function readQuest(id) {
+    const row = quest(id);
+    return {
+      ...row,
+      latest: revision(id, row.latest_revision),
+      published:
+        row.published_revision === null
+          ? null
+          : revision(id, row.published_revision),
+      commitment:
+        db
+          .prepare("SELECT * FROM creator_xp_commitments WHERE quest_id=?")
+          .get(id) ?? null,
+      openParticipations: db
+        .prepare(
+          "SELECT count(*) AS n FROM creator_participations WHERE quest_id=? AND state='open'",
+        )
+        .get(id).n,
+    };
+  }
+  function authorOwns(row, actor) {
+    fail(
+      row.author === actor,
+      "Only the author can change this quest.",
+      "CREATOR_FORBIDDEN",
+      403,
+    );
+  }
+  function moderator(row, actor) {
+    fail(
+      actor !== row.author && isModerator(actor) === true,
+      "Independent moderation authority is required.",
+      "CREATOR_FORBIDDEN",
+      403,
+    );
+  }
+  function version(row, expectedVersion) {
+    integer(expectedVersion, 1);
+    fail(
+      row.version === expectedVersion,
+      "The creator quest changed. Refresh before continuing.",
+      "CREATOR_STALE",
+    );
+  }
+  function touch(id, state, now) {
+    db.prepare(
+      "UPDATE creator_quests SET state=?,version=version+1,updated_at=? WHERE id=?",
+    ).run(state, now, id);
+  }
+  const operation = createCreatorOperations(db, { clock });
+  function publicationQuote(actor, questId) {
+    const row = quest(questId);
+    authorOwns(row, actor);
+    const policyVersion = row.policy_version ?? configuredPolicy.version;
+    const xp = db
+      .prepare("SELECT xp_commitment FROM creator_policies WHERE version=?")
+      .get(policyVersion).xp_commitment;
+    return {
+      domain: "demo",
+      policyVersion,
+      xpCommitment: xp,
+      additionalLockedXp: row.published_revision === null ? xp : 0,
+      expectedVersion: row.version,
+      canSubmit:
+        ["draft", "published"].includes(row.state) &&
+        revision(questId, row.latest_revision).state === "draft",
+      progression: progression(actor),
+    };
+  }
+  function result(id) {
+    const row = readQuest(id);
+    return { quest: row, progression: progression(row.author) };
+  }
+
+  return {
+    // Private service reads; these are not public discovery serializers.
+    progression,
+    readQuest,
+    participation,
+    publicationQuote,
+    createDraft({ actor, operationId, questId, draft }) {
+      key(questId);
+      const validated = content(draft);
+      return operation(
+        "createDraft",
+        actor,
+        operationId,
+        { questId, draft: validated },
+        (now) => {
+          player(actor);
+          fail(
+            !db.prepare("SELECT 1 FROM creator_quests WHERE id=?").get(questId),
+            "Creator quest identity already exists.",
+          );
+          db.prepare(
+            "INSERT INTO creator_quests VALUES (?,?,'draft',1,1,NULL,NULL,?,?)",
+          ).run(questId, actor, now, now);
+          db.prepare(
+            "INSERT INTO creator_revisions VALUES (?,1,?,'draft',NULL,NULL,NULL)",
+          ).run(questId, JSON.stringify(validated));
+          return result(questId);
+        },
+      );
+    },
+    revise({ actor, operationId, questId, expectedVersion, draft }) {
+      const validated = content(draft);
+      return operation(
+        "revise",
+        actor,
+        operationId,
+        { questId, expectedVersion, draft: validated },
+        (now) => {
+          const row = quest(questId);
+          authorOwns(row, actor);
+          version(row, expectedVersion);
+          fail(
+            ["draft", "rejected", "published"].includes(row.state),
+            "This quest cannot be edited now.",
+          );
+          fail(
+            revision(questId, row.latest_revision).state !== "pending_review",
+            "Withdraw the pending review before editing.",
+          );
+          const next = integer(row.latest_revision + 1, 1);
+          db.prepare(
+            "INSERT INTO creator_revisions VALUES (?,?,?,'draft',NULL,NULL,NULL)",
+          ).run(questId, next, JSON.stringify(validated));
+          db.prepare(
+            "UPDATE creator_quests SET latest_revision=? WHERE id=?",
+          ).run(next, questId);
+          touch(
+            questId,
+            row.state === "published" ? "published" : "draft",
+            now,
+          );
+          return result(questId);
+        },
+      );
+    },
+    submit({
+      actor,
+      operationId,
+      questId,
+      expectedVersion,
+      expectedPolicyVersion,
+    }) {
+      return operation(
+        "submit",
+        actor,
+        operationId,
+        { questId, expectedVersion, expectedPolicyVersion },
+        (now) => {
+          const row = quest(questId);
+          authorOwns(row, actor);
+          version(row, expectedVersion);
+          fail(
+            ["draft", "published"].includes(row.state),
+            "This quest cannot enter review now.",
+          );
+          fail(
+            revision(questId, row.latest_revision).state === "draft",
+            "Only a draft revision can enter review.",
+          );
+          fail(
+            key(expectedPolicyVersion) ===
+              (row.policy_version ?? configuredPolicy.version),
+            "The XP quote changed. Review the current publication policy.",
+            "CREATOR_POLICY_CHANGED",
+          );
+          db.prepare(
+            "UPDATE creator_revisions SET state='pending_review',policy_version=? WHERE quest_id=? AND revision=?",
+          ).run(
+            row.policy_version ?? configuredPolicy.version,
+            questId,
+            row.latest_revision,
+          );
+          touch(
+            questId,
+            row.state === "published" ? "published" : "pending_review",
+            now,
+          );
+          return result(questId);
+        },
+      );
+    },
+    withdrawReview({ actor, operationId, questId, expectedVersion }) {
+      return operation(
+        "withdrawReview",
+        actor,
+        operationId,
+        { questId, expectedVersion },
+        (now) => {
+          const row = quest(questId);
+          authorOwns(row, actor);
+          version(row, expectedVersion);
+          fail(
+            ["pending_review", "published"].includes(row.state) &&
+              revision(questId, row.latest_revision).state === "pending_review",
+            "No withdrawable creator review exists.",
+          );
+          db.prepare(
+            "UPDATE creator_revisions SET state='withdrawn' WHERE quest_id=? AND revision=?",
+          ).run(questId, row.latest_revision);
+          touch(
+            questId,
+            row.state === "published" ? "published" : "draft",
+            now,
+          );
+          return result(questId);
+        },
+      );
+    },
+    review({ actor, operationId, questId, expectedVersion, decision, reason }) {
+      fail(
+        ["approve", "reject"].includes(decision),
+        "Invalid moderation decision.",
+        "CREATOR_INPUT",
+        400,
+      );
+      const explanation = text(reason, 1000);
+      return operation(
+        "review",
+        actor,
+        operationId,
+        { questId, expectedVersion, decision, reason: explanation },
+        (now) => {
+          const row = quest(questId);
+          moderator(row, actor);
+          version(row, expectedVersion);
+          const candidate = revision(questId, row.latest_revision);
+          fail(
+            ["pending_review", "published"].includes(row.state) &&
+              candidate.state === "pending_review",
+            "No reviewable creator revision exists.",
+          );
+          if (decision === "approve" && row.published_revision === null) {
+            const xp = db
+              .prepare(
+                "SELECT xp_commitment FROM creator_policies WHERE version=?",
+              )
+              .get(candidate.policy_version).xp_commitment;
+            fail(
+              progression(row.author).availableXp >= xp,
+              "The author no longer has enough available XP to publish.",
+              "CREATOR_INSUFFICIENT_XP",
+            );
+            db.prepare(
+              "INSERT INTO creator_xp_commitments VALUES (?,?,?,?,?,NULL)",
+            ).run(questId, row.author, xp, candidate.policy_version, now);
+            db.prepare(
+              "UPDATE creator_quests SET policy_version=? WHERE id=?",
+            ).run(candidate.policy_version, questId);
+          }
+          db.prepare(
+            "UPDATE creator_revisions SET state=?,reviewed_by=?,reason=? WHERE quest_id=? AND revision=?",
+          ).run(
+            decision === "approve" ? "approved" : "rejected",
+            actor,
+            explanation,
+            questId,
+            row.latest_revision,
+          );
+          if (decision === "approve")
+            db.prepare(
+              "UPDATE creator_quests SET published_revision=? WHERE id=?",
+            ).run(row.latest_revision, questId);
+          touch(
+            questId,
+            decision === "approve" || row.published_revision !== null
+              ? "published"
+              : "rejected",
+            now,
+          );
+          return result(questId);
+        },
+      );
+    },
+    start({ actor, operationId, questId }) {
+      return operation("start", actor, operationId, { questId }, (now) => {
+        const row = quest(questId);
+        player(actor);
+        fail(
+          row.state === "published",
+          "This creator quest is not accepting new starts.",
+        );
+        fail(
+          row.author !== actor,
+          "Authors cannot validate their own participation.",
+          "CREATOR_FORBIDDEN",
+          403,
+        );
+        fail(
+          authorizeAdmission(actor, questId) === true,
+          "This creator quest is not accepting your participation.",
+          "CREATOR_NOT_FOUND",
+          404,
+        );
+        fail(
+          !participation(questId, actor),
+          "This player already started this stable quest.",
+          "CREATOR_ALREADY_STARTED",
+        );
+        db.prepare(
+          "INSERT INTO creator_participations VALUES (?,?,?,'open',?,NULL,NULL,NULL)",
+        ).run(questId, actor, row.published_revision, now);
+        return { participation: participation(questId, actor) };
+      });
+    },
+    resolve({ actor, operationId, questId, participant, resolutionReference }) {
+      key(participant);
+      const reference = key(resolutionReference);
+      return operation(
+        "resolve",
+        actor,
+        operationId,
+        { questId, participant, resolutionReference: reference },
+        (now) => {
+          const row = quest(questId);
+          fail(
+            actor !== row.author &&
+              actor !== participant &&
+              isCompletionAuthority(actor) === true,
+            "Independent completion authority is required.",
+            "CREATOR_FORBIDDEN",
+            403,
+          );
+          fail(
+            participation(questId, participant)?.state === "open",
+            "No open participation exists.",
+          );
+          db.prepare(
+            "UPDATE creator_participations SET state='resolved',resolved_at=?,resolved_by=?,resolution_reference=? WHERE quest_id=? AND participant=?",
+          ).run(now, actor, reference, questId, participant);
+          return { participation: participation(questId, participant) };
+        },
+      );
+    },
+    close({ actor, operationId, questId, expectedVersion }) {
+      return operation(
+        "close",
+        actor,
+        operationId,
+        { questId, expectedVersion },
+        (now) => {
+          const row = quest(questId);
+          authorOwns(row, actor);
+          version(row, expectedVersion);
+          fail(
+            !["closing", "closed"].includes(row.state),
+            "This quest is already closing or closed.",
+          );
+          db.prepare(
+            "UPDATE creator_revisions SET state='withdrawn' WHERE quest_id=? AND state IN ('draft','pending_review')",
+          ).run(questId);
+          // Finalization checks obligations and releases XP under one write lock.
+          touch(
+            questId,
+            row.published_revision === null ? "closed" : "closing",
+            now,
+          );
+          return result(questId);
+        },
+      );
+    },
+    finalize({ actor, operationId, questId, expectedVersion }) {
+      return operation(
+        "finalize",
+        actor,
+        operationId,
+        { questId, expectedVersion },
+        (now) => {
+          const row = quest(questId);
+          authorOwns(row, actor);
+          version(row, expectedVersion);
+          fail(row.state === "closing", "This quest is not closing.");
+          fail(
+            readQuest(questId).openParticipations === 0,
+            "Existing participant obligations must be resolved before XP is released.",
+            "CREATOR_OBLIGATIONS_OPEN",
+          );
+          const released = db
+            .prepare(
+              "UPDATE creator_xp_commitments SET released_at=? WHERE quest_id=? AND released_at IS NULL",
+            )
+            .run(now, questId);
+          fail(
+            released.changes === 1,
+            "The creator commitment needs reconciliation.",
+            "CREATOR_XP_INVARIANT",
+            503,
+          );
+          touch(questId, "closed", now);
+          return result(questId);
+        },
+      );
+    },
+  };
+}
diff --git a/server/creators/node-handler.mjs b/server/creators/node-handler.mjs
new file mode 100644
index 0000000..c65fac4
--- /dev/null
+++ b/server/creators/node-handler.mjs
@@ -0,0 +1,69 @@
+import { PassThrough, Readable } from "node:stream";
+import { createCreatorApi } from "./api.mjs";
+import { creatorAssert } from "./operations.mjs";
+
+// Mount before the host consumes its JSON body. The host retains session, rate-limit
+// and deployment controls; actor lookup receives the original IncomingMessage.
+export function createNodeCreatorHandler({ authenticate, origin, ...options }) {
+  creatorAssert(
+    typeof authenticate === "function",
+    "Creator routes require session authentication.",
+    "CREATOR_CONFIG",
+    500,
+  );
+  const incomingRequests = new WeakMap();
+  const handle = createCreatorApi({
+    ...options,
+    origin,
+    authenticate: (request) => authenticate(incomingRequests.get(request)),
+  });
+  return async function handleNodeCreatorRequest(req, res) {
+    const url = new URL(req.url, origin);
+    if (!(
+      url.pathname === "/api/creator-community" ||
+      url.pathname.startsWith("/api/creator-community/")
+    ))
+      return false;
+    const headers = new Headers();
+    for (const [name, value] of Object.entries(req.headers)) {
+      if (value !== undefined)
+        headers.set(name, Array.isArray(value) ? value.join(", ") : value);
+    }
+    const hasBody = !["GET", "HEAD"].includes(req.method);
+    // Cancelling an oversized Web body must not destroy the HTTP socket before
+    // the server can return 413. Isolate cancellation on a bounded intermediary.
+    const body = hasBody ? new PassThrough() : null;
+    if (body) {
+      body.on("error", () => {
+        req.unpipe(body);
+        if (!req.destroyed) req.resume();
+      });
+      req.once("aborted", () =>
+        body.destroy(new Error("Creator request aborted.")),
+      );
+      req.once("error", (error) => body.destroy(error));
+      req.pipe(body);
+    }
+    const request = new Request(url, {
+      method: req.method,
+      headers,
+      ...(hasBody ? { body: Readable.toWeb(body), duplex: "half" } : {}),
+    });
+    incomingRequests.set(request, req);
+    try {
+      const response = await handle(request);
+      if (!response) return false;
+      if (!req.complete && !req.destroyed) req.resume();
+      res.writeHead(response.status, Object.fromEntries(response.headers));
+      res.end(Buffer.from(await response.arrayBuffer()));
+      return true;
+    } finally {
+      incomingRequests.delete(request);
+      if (body) {
+        req.unpipe(body);
+        body.destroy();
+        if (!req.complete && !req.destroyed) req.resume();
+      }
+    }
+  };
+}
diff --git a/server/creators/operations.mjs b/server/creators/operations.mjs
new file mode 100644
index 0000000..7a4a8f3
--- /dev/null
+++ b/server/creators/operations.mjs
@@ -0,0 +1,111 @@
+import { atomic } from "../database.mjs";
+import { assert, hash } from "../domain.mjs";
+
+export const creatorAssert = (
+  condition,
+  message,
+  code = "CREATOR_CONFLICT",
+  status = 409,
+) => assert(condition, message, status, code);
+export function creatorKey(value) {
+  creatorAssert(
+    typeof value === "string" &&
+      /^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$/.test(value),
+    "Invalid creator identifier.",
+    "CREATOR_INPUT",
+    400,
+  );
+  return value;
+}
+export function creatorInteger(value, min = 0) {
+  creatorAssert(
+    Number.isSafeInteger(value) && value >= min,
+    "Invalid creator integer.",
+    "CREATOR_INPUT",
+    400,
+  );
+  return value;
+}
+export function creatorText(value, max, { optional = false } = {}) {
+  creatorAssert(
+    typeof value === "string" &&
+      value.length <= max &&
+      (optional || value.trim().length > 0) &&
+      !/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/.test(value),
+    "Invalid creator text.",
+    "CREATOR_INPUT",
+    400,
+  );
+  return value.trim();
+}
+export function creatorFields(value, names) {
+  creatorAssert(
+    value &&
+      typeof value === "object" &&
+      !Array.isArray(value) &&
+      Object.keys(value).sort().join() === [...names].sort().join(),
+    "Unexpected or missing creator fields.",
+    "CREATOR_INPUT",
+    400,
+  );
+}
+const canonical = (value) =>
+  JSON.stringify(value, (_, v) =>
+    v && typeof v === "object" && !Array.isArray(v)
+      ? Object.fromEntries(
+          Object.keys(v)
+            .sort()
+            .map((k) => [k, v[k]]),
+        )
+      : v,
+  );
+
+// All creator services share one actor-scoped receipt namespace and write lock.
+// creator_operations is created by explicit lifecycle initialization.
+export function createCreatorOperations(db, { clock = Date.now } = {}) {
+  return (command, actor, operationId, input, perform) => {
+    creatorKey(actor);
+    creatorKey(operationId);
+    const fingerprint = hash(canonical({ command, input }));
+    return atomic(db, () => {
+      const existing = db
+        .prepare(
+          "SELECT * FROM creator_operations WHERE actor=? AND operation_id=?",
+        )
+        .get(actor, operationId);
+      if (existing) {
+        creatorAssert(
+          existing.fingerprint === fingerprint,
+          "This operation ID already identifies another creator action.",
+          "CREATOR_OPERATION_REUSED",
+        );
+        return JSON.parse(existing.receipt);
+      }
+      const now = creatorInteger(clock());
+      const result = perform(now);
+      creatorAssert(
+        !result?.then,
+        "Creator mutations must be synchronous.",
+        "CREATOR_STORAGE",
+        500,
+      );
+      const receipt = {
+        domain: "demo",
+        operationId,
+        command,
+        confirmedAt: now,
+        ...result,
+      };
+      const encoded = JSON.stringify(receipt);
+      db.prepare("INSERT INTO creator_operations VALUES (?,?,?,?,?,?)").run(
+        actor,
+        operationId,
+        command,
+        fingerprint,
+        encoded,
+        now,
+      );
+      return JSON.parse(encoded);
+    });
+  };
+}
