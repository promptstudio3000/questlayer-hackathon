+  );
+  for (const action of ["review", "resolve", "constructor", "toString"]) {
+    assert.equal(
+      (
+        await f.request(`/quests/river/${action}`, {
+          method: "POST",
+          body: { operationId: f.op() },
+        })
+      ).status,
