# All simulated balances live in the separate demo realm.
PORT=8787
HOST=127.0.0.1
# Set to loopback only behind the local Caddy proxy; leave empty for direct development.
TRUST_PROXY=
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=.data/questlayer-hackathon.sqlite
# testnet (default) or mainnet; every server module reads this one value.
# testnet (default) or mainnet; every server module reads this one value.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Set ONLY after deploying and verifying the contracts. No player keys.
NEAR_GAME_CONTRACT=
NEAR_VAULT_CONTRACT=
NEAR_COLLECTIBLES_CONTRACT=
NEAR_INTENTS_CONTRACT=
# NEAR AI Cloud (private inference in TEEs) for NPCs, guide and flavour text.
# Off unless NEAR_AI_ENABLED=1 AND a key is set (docs/NEAR-AI-CLOUD.md). The
# key belongs only in the VPS runtime.env, never in git or logs.
NEAR_AI_ENABLED=
NEAR_AI_API_KEY=
# Default deepseek-ai/DeepSeek-V4.1-Flash-1017 (attested).
NEAR_AI_MODEL=
# 1 (default) checks each NPC reply's enclave signature in the background.
NEAR_AI_VERIFY=
# Optional Base RPC for read-only cosmetic ownership, never asset transfers.
BASE_RPC_URL=https://mainnet.base.org
# Invisible player accounts and sponsored gas (testnet only). Keys are private
# files created by scripts/deploy-player-factory-testnet.mjs; never commit them.
PLAYER_FACTORY_ACCOUNT=
PLAYER_FACTORY_KEY_PATH=
RELAYER_KEY_PATH=
# Optional limits (yoctoNEAR integers / counts); see docs/RELAYER.md for defaults.
PLAYER_FACTORY_FUND_YOCTO=
RELAY_TOPUP_CAP_YOCTO=
RELAY_MAX_JOBS_PER_DAY=
# Storage deposits (0.05 NEAR each) the relayer carries per account and UTC day; default 0.5 NEAR.
RELAY_MAX_DEPOSIT_YOCTO_PER_DAY=
RELAY_MAX_GAS=
RELAY_BLOCK_TTL=
# Creator money publisher (testnet). A function-call key of the creators contract
# limited to register_quest/set_price/close_quest/record_support/open_round/
# finalize_round; created by scripts/deploy-creators-testnet.mjs. Without it the
# server only reads and quotes creator payments.
CREATORS_PUBLISHER_KEY_PATH=
# Daily support round budget in yoctoNEAR (default 1e22 = 0.01 NEAR), capped by
# the contract policy and by the funded pot.
CREATOR_ROUND_BUDGET_YOCTO=
DISABLE_RELAYER=
# Optional IPFS add endpoint (Kubo RPC /api/v0/add or compatible) and bearer
# token for pinning sanitized public note photos. Without it records carry the
# content address only and pinning is reported as unavailable.
IPFS_ADD_URL=
IPFS_ADD_TOKEN=
