# All simulated balances live in the separate demo realm.
PORT=8787
HOST=127.0.0.1
# Set to loopback only behind the local Caddy proxy; leave empty for direct development.
TRUST_PROXY=
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=.data/questlayer-hackathon.sqlite
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Set ONLY after deploying and verifying the contracts. No player keys.
NEAR_GAME_CONTRACT=
NEAR_VAULT_CONTRACT=
NEAR_COLLECTIBLES_CONTRACT=
NEAR_INTENTS_CONTRACT=
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# Optional Base RPC for read-only cosmetic ownership, never asset transfers.
BASE_RPC_URL=https://mainnet.base.org
# Invisible player accounts and sponsored gas (testnet only). Keys are private
# files created by scripts/deploy-player-factory-testnet.mjs; never commit them.
PLAYER_FACTORY_ACCOUNT=
PLAYER_FACTORY_KEY_PATH=
RELAYER_KEY_PATH=
# Optional limits (yoctoNEAR integers / counts); see docs/RELAYER.md for defaults.
PLAYER_FACTORY_FUND_YOCTO=
RELAY_TOPUP_CAP_YOCTO=
RELAY_MAX_JOBS_PER_DAY=
RELAY_MAX_GAS=
RELAY_MAX_BUY_DEPOSIT_YOCTO=
RELAY_BLOCK_TTL=
DISABLE_RELAYER=
