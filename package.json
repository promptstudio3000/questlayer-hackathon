{
  "name": "questlayer-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "test:mainnet": "node scripts/test-mainnet.mjs",
    "check": "npm run build && npm run budget && npm test && npm run test:mainnet",
    "budget": "node scripts/check-bundle-budget.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "test:contracts": "bash scripts/build-contracts.sh --test",
    "contracts:docker": "bash scripts/build-contracts-docker.sh",
    "check:clean-clone": "bash scripts/clean-clone-check.sh",
    "world:prepare": "node server/prepare-worlds.mjs --once",
    "world:preview": "node server/prepare-worlds.mjs --preview",
    "world:validate": "node server/cli/world-validate.mjs",
    "world:pilot": "node scripts/run-world-pilot.mjs",
    "staking:probe": "node scripts/probe-staking-testnet.mjs",
    "funding:simulate": "node scripts/simulate-native-funding.mjs",
    "e2e:first-session": "node scripts/e2e-first-session.mjs",
    "e2e:bonus-vote": "node scripts/e2e-bonus-vote.mjs",
    "e2e:world": "node scripts/e2e-world-journeys.mjs",
    "pilot:city": "node scripts/rehearse-city-pilot.mjs",
    "market:upgrade": "node scripts/upgrade-market-v2-testnet.mjs",
    "market:fixture": "node scripts/lib/signed-order-fixture.mjs",
    "seed:test": "node scripts/test-seed.mjs",
    "poi:classify": "node server/poi/cli.mjs",
    "world:coverage": "node scripts/world-coverage.mjs",
    "ai:flavour": "node server/cli/ai-flavour.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@hot-labs/near-connect": "0.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@turf/turf": "7.4.0",
    "borsh": "2.0.0",
    "h3-js": "^4.3.0",
    "maplibre-gl": "6.16.0",
    "near-api-js": "7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "three": "0.187.0",
    "tz-lookup": "^6.1.25",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "latest",
    "axe-core": "4.14.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/promptstudio3000/questlayer-hackathon.git"
  }
}
