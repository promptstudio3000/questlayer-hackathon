{
  "name": "questlayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "test:contracts": "env PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --manifest-path contracts/Cargo.toml --workspace",
    "world:prepare": "node server/prepare-worlds.mjs --once",
    "world:preview": "node server/prepare-worlds.mjs --preview"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@turf/turf": "7.4.0",
    "h3-js": "^4.3.0",
    "maplibre-gl": "6.16.0",
    "near-api-js": "7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tz-lookup": "^6.1.25",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
}
